const express = require('express');
const multer = require('multer');
const path = require('path');
const fs = require('fs');

const app = express();
const PORT = 3000;

// إنشاء مجلد uploads لو مش موجود
const uploadDir = path.join(__dirname, 'uploads');
if (!fs.existsSync(uploadDir)) {
  fs.mkdirSync(uploadDir);
}

// إعدادات تخزين الصور
const storage = multer.diskStorage({
  destination: (req, file, cb) => {
    cb(null, uploadDir);
  },
  filename: (req, file, cb) => {
    const uniqueName = Date.now() + '-' + Math.round(Math.random() * 1e9);
    const ext = path.extname(file.originalname);
    cb(null, uniqueName + ext);
  }
});

// فلتر للصور فقط
const fileFilter = (req, file, cb) => {
  if (file.mimetype.startsWith('image/')) {
    cb(null, true);
  } else {
    cb(new Error('الملف ليس صورة!'), false);
  }
};

const upload = multer({
  storage: storage,
  fileFilter: fileFilter,
  limits: { fileSize: 5 * 1024 * 1024 }
});

// تقديم الملفات الثابتة
app.use(express.static('public'));
app.use('/uploads', express.static(uploadDir));

// صفحة عرض الصور (خاصة بيك)
app.get('/admin', (req, res) => {
  fs.readdir(uploadDir, (err, files) => {
    if (err) return res.send('خطأ في قراءة الملفات');

    let html = `
      <!DOCTYPE html>
      <html lang="ar" dir="rtl">
      <head>
        <meta charset="UTF-8">
        <title>الصور المرفوعة</title>
        <style>
          body { font-family: Arial; background: #f0f2f5; padding: 20px; }
          h1 { text-align: center; color: #333; }
          .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }
          .card { background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 3px 10px rgba(0,0,0,0.1); }
          .card img { width: 100%; height: 180px; object-fit: cover; display: block; }
          .card p { font-size: 12px; padding: 8px; margin: 0; color: #666; word-break: break-all; }
          .empty { text-align: center; color: #999; margin-top: 50px; }
        </style>
      </head>
      <body>
        <h1>📸 الصور المرفوعة (${files.length})</h1>
    `;

    if (files.length === 0) {
      html += '<p class="empty">لا توجد صور بعد</p>';
    } else {
      html += '<div class="grid">';
      files.reverse().forEach(file => {
        html += `
          <div class="card">
            <img src="/uploads/${file}" alt="${file}">
            <p>${file}</p>
          </div>
        `;
      });
      html += '</div>';
    }

    html += '</body></html>';
    res.send(html);
  });
});

// استقبال رفع الصورة
app.post('/upload', upload.single('image'), (req, res) => {
  if (!req.file) {
    return res.status(400).json({ error: 'لم يتم رفع صورة' });
  }
  res.json({
    success: true,
    message: 'تم رفع الصورة بنجاح',
    filename: req.file.filename,
    url: `/uploads/${req.file.filename}`
  });
});

// معالجة الأخطاء
app.use((err, req, res, next) => {
  res.status(400).json({ error: err.message });
});

app.listen(PORT, () => {
  console.log(`✅ السيرفر يعمل على المنفذ ${PORT}`);
});
